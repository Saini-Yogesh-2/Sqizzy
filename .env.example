# ==========================================
# SQIZZY ROOT ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==========================================

# Node Environment (development | production)
NODE_ENV=development

# Server Port
PORT=5000

# Frontend URL (Used by Backend for CORS whitelist)
FRONTEND_URL=http://localhost:3000

# Backend API URL (Used by Frontend to communicate with Backend)
VITE_API_URL=http://localhost:5000

# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sqizzy?retryWrites=true&w=majority

# Admin Authentication Secrets
ADMIN_PASSWORD=YourStrongAdminPasswordHere!
ADMIN_JWT_SECRET=your_random_64_character_jwt_secret_key_here
