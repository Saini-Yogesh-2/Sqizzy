# ==========================================
# SQIZZY BACKEND ENVIRONMENT TEMPLATE
# ==========================================

PORT=5000
NODE_ENV=production

# Set to your deployed frontend domain in production (e.g. https://sqizzy.co or https://your-project.vercel.app)
FRONTEND_URL=https://sqizzy.co

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sqizzy?retryWrites=true&w=majority

# Strong password for /admin login (Minimum 12 characters recommended)
ADMIN_PASSWORD=YourStrongAdminPasswordHere!

# 64-character random string for signing JWT tokens
ADMIN_JWT_SECRET=your_random_64_character_jwt_secret_key_here
